OPENAI_API_KEY=
# gpt-5-mini gives the same derivation quality as gpt-5 at ~1/6 the cost and about
# half the latency (measured: $0.008 vs $0.051 per function). gpt-4o is cheaper still
# but corrupts long Korean output, so it is not recommended.
OPENAI_MODEL=gpt-5-mini
# Only sent for gpt-5* models. Default effort runs past 300s per function; "low" keeps
# the full derivation at ~30s.
OPENAI_REASONING_EFFORT=low
